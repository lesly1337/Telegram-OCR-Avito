# ---- Telegram ----
BOT_TOKEN=123456:replace-me
# список админов через запятую
ADMIN_IDS=123456789

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ---- Avito ----
AVITO_BASE_URL=https://www.avito.ru
AVITO_MAX_ITEMS_DEFAULT=30
AVITO_REQUEST_DELAY=1.5
AVITO_HEADLESS=true
AVITO_USE_FIXTURES=false

# ---- OCR ----
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=rus+eng
OCR_MAX_IMAGES_PER_ITEM=6

# ---- Paths ----
DATA_DIR=./data
DB_PATH=./data/app.db
TMP_DIR=./data/tmp

# ---- Logging ----
LOG_LEVEL=INFO