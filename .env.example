# ---- Telegram ----
BOT_TOKEN=123456:replace-me
# Прокси только для Telegram: http://user:password@host:port или socks5://user:password@host:port.
# Пустое значение — напрямую. Прокси должен иметь доступ к api.telegram.org.
TELEGRAM_PROXY_URL=
# Для Docker Desktop можно указать отдельный адрес, например http://host.docker.internal:10809.
# Если не задан, контейнер использует TELEGRAM_PROXY_URL.
TELEGRAM_DOCKER_PROXY_URL=
# список админов через запятую
ADMIN_IDS=123456789

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Порт Ollama на хосте при запуске через Docker Compose.
OLLAMA_HOST_PORT=11435

# ---- Avito ----
AVITO_BASE_URL=https://www.avito.ru
AVITO_MAX_ITEMS_DEFAULT=30
AVITO_REQUEST_DELAY=1.5
AVITO_HEADLESS=true
AVITO_USE_FIXTURES=false
# Прокси только для Avito и загрузки его изображений; пустое значение — напрямую.
PROXY_URL=

# ---- OCR ----
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=rus+eng
OCR_MAX_IMAGES_PER_ITEM=6

# ---- Paths ----
DATA_DIR=./data
DB_PATH=./data/app.db
TMP_DIR=./data/tmp

# ---- Logging ----
LOG_LEVEL=INFO

# Формат: http://user:pass@host:port
PROXY_URL=
TELEGRAM_DOCKER_PROXY_URL=
